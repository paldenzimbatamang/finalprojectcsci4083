# Copy this file to .env and fill in your own keys.
# .env is listed in .gitignore, so your keys are never committed.

# Set to 1 to test the whole pipeline without paid API calls.
MOCK_MODE=0

# Planner + text agents (Anthropic)
ANTHROPIC_API_KEY=
# Optional: use a cheaper model for testing, e.g. claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5

# Video agent (Google Veo through Vertex AI, billed to Google Cloud free-trial credits)
# No API key here: log in once with `gcloud auth application-default login`.
# Your project ID from the Google Cloud console (e.g. my-travel-project-123456)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Cheapest settings. Other models, e.g. veo-3.1-generate-001, cost more.
VEO_MODEL=veo-3.1-lite-generate-001
VEO_RESOLUTION=720p

# Audio agent (ElevenLabs)
ELEVENLABS_API_KEY=
